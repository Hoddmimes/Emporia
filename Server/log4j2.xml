<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n"/>
        </Console>
        <File name="File" fileName="server.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n"/>
        </File>
    </Appenders>
    <Loggers>
        <!-- Application logging -->
        <Logger name="com.hoddmimes" level="INFO"/>
        <!-- Set to TRACE to log all inbound requests and outbound responses -->
        <Logger name="com.hoddmimes.emporia.server.RestApi" level="TRACE"/>
        <Logger name="com.hoddmimes.emporia.server.endpoints.OrderEndpoints" level="TRACE"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
